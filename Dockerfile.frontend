# syntax=docker/dockerfile:1
# Frontend image: Vite build served by nginx.
# Build context is the REPO ROOT (index.html, vite.config.mjs, src/index.jsx and public/ live there):
#   docker build -t peers-frontend:local -f Dockerfile.frontend .
# Keep the Node major in sync with .nvmrc, package.json "engines" and render.yaml.

# ---- build stage -------------------------------------------------------------
FROM node:24-alpine AS build
WORKDIR /app

# REACT_APP_API_URL is read by vite.config.mjs at BUILD time and written into the JS
# bundle (see src/frontend/services/apiUrl.js). Changing them needs a rebuild;
# setting them when the container starts does nothing. They are public: anyone
# can read them in the browser, so never pass secrets here.
# The default matches what the browser must call when Compose publishes the
# backend on localhost:5000.
ARG REACT_APP_API_URL=http://localhost:5000/api
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# --ignore-scripts: the root "postinstall" runs `cd src/backend && npm ci`, but
# the backend is deliberately not in this build context (see .dockerignore).
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY index.html vite.config.mjs ./
COPY public ./public
COPY src/index.jsx ./src/index.jsx
COPY src/frontend ./src/frontend
RUN npm run build

# ---- runtime stage -----------------------------------------------------------
# Keep this on nginx's stable branch (an even minor number, such as 1.30): it gets security
# fixes for about a year. Mainline (odd, such as 1.27) stops being supported when the next
# one appears, which is how 1.27 became unsupported. Move to the next stable branch each spring.
FROM nginx:1.30-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
