# syntax=docker/dockerfile:1
# Frontend image: Create React App build served by nginx.
# Build context is the REPO ROOT (CRA's src/index.js and public/ live there):
#   docker build -t peers-frontend:local -f Dockerfile.frontend .
# Keep the Node major in sync with .nvmrc, package.json "engines" and render.yaml.

# ---- build stage -------------------------------------------------------------
FROM node:24-alpine AS build
WORKDIR /app

# REACT_APP_* values are read by webpack at BUILD time and written into the JS
# bundle (see src/frontend/services/apiUrl.js). Changing them needs a rebuild;
# setting them when the container starts does nothing. They are public: anyone
# can read them in the browser, so never pass secrets here.
# The default matches what the browser must call when Compose publishes the
# backend on localhost:5000.
ARG REACT_APP_API_URL=http://localhost:5000/api
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# --ignore-scripts: the root "postinstall" runs `cd src/backend && npm ci`, but
# the backend is deliberately not in this build context (see .dockerignore).
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY public ./public
COPY src/index.js ./src/index.js
COPY src/frontend ./src/frontend
RUN npm run build

# ---- runtime stage -----------------------------------------------------------
FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
