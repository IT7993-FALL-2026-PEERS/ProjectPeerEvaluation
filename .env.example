# Settings for `docker compose` (npm run docker:up). `npm run setup` copies this file to .env and
# replaces JWT_SECRET with a random value. src/backend/.env.example is for `npm run dev`; the two
# are separate files on purpose. .env is never committed.

# Signs login tokens. Required: Compose refuses to start without it, and the container runs with
# NODE_ENV=production, so it must be at least 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters

# Optional (defaults shown):
# DOCKER_MONGODB_URI=mongodb://mongo:27017/peer-eval
# FRONTEND_PORT=3000
# BACKEND_PORT=5000
# MONGO_PORT=27017
# URL the browser uses for the API. Baked into the frontend image at build time.
# FRONTEND_API_URL=http://localhost:5000/api
