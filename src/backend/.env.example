MONGODB_URI=mongodb://localhost:27017/peer-eval
# Signs login tokens. Required in production (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
# Milliseconds to wait between emails in a batch (invitations, reminders).
# Leave at 0 unless your mail provider rate-limits; Mailtrap's free sandbox
# allows 1 email per 10 seconds, so use 11000 with it.
EMAIL_SEND_INTERVAL_MS=0
# Days a student's evaluation link works after the latest invitation or reminder.
# Unset means 14.
EVALUATION_TOKEN_TTL_DAYS=14
# Rate limits per client address (see docs/architecture/api-documentation.md section 1).
# Optional whole numbers above 0; anything else keeps the default shown here.
# RATE_LIMIT_LOGIN_MAX=10         failed logins per 15 minutes
# RATE_LIMIT_SIGNUP_MAX=10        registrations per hour
# RATE_LIMIT_RESET_MAX=5          password reset requests (emails) per hour
# RATE_LIMIT_UPDATE_MAX=20        password updates with a reset link per hour
# RATE_LIMIT_EVALUATE_MAX=600     student evaluation link requests per 15 minutes
# RATE_LIMIT_GENERAL_MAX=1000     all other API requests per 15 minutes
# Proxies in front of the app. Render has two (Cloudflare and its load balancer), which is the
# default; set 0 when running with no proxy. Leave unset on Render.
# TRUST_PROXY=2