# Copy to .env for local development (node index.js / npm start, not
# through Docker -- Dockerfile's .dockerignore excludes .env from the image,
# and docker-compose.yml/scripts/run-local.sh set these as real environment
# variables instead of reading this file).

# Local MongoDB (e.g. `docker compose up -d mongo`, or a natively installed
# mongod). To point at MongoDB Atlas instead, replace this with your
# cluster's connection string from Atlas: Database -> Connect -> Drivers,
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# ?retryWrites=true&w=majority -- and make sure Atlas Network Access allows
# your current IP. Production (render.yaml) uses Atlas via this same
# MONGODB_URI variable, set as a Render secret, not read from this file.
MONGODB_URI=mongodb://localhost:27017/peer-eval

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
