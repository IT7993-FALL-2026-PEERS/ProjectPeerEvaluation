{
  "name": "peer-evaluation-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "pretest:integration": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "test:integration": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/integration-tests.xml \"integration/**/*.integration.js\"",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "test:coverage": "c8 --all --src=. --include=\"controllers/**/*.js\" --include=\"middleware/**/*.js\" --include=\"models/**/*.js\" --include=\"routes/**/*.js\" --include=\"utils/**/*.js\" --include=\"config/**/*.js\" --include=\"index.js\" --reporter=lcov --reporter=text-summary --report-dir=coverage node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/backend-tests.xml \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
