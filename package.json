{
  "name": "peer-evaluation-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "axios": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "lint": "eslint src/frontend --ext .js,.jsx --max-warnings=0",
    "eject": "react-scripts eject",
    "start:backend": "cd src/backend && npm start",
    "start:frontend": "cross-env HOST=0.0.0.0 react-scripts start",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
        "setup": "node scripts/setup.js",
    "verify": "bash scripts/verify-env.sh",
    "docker:up": "node scripts/setup.js --env-only && docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "postinstall": "cd src/backend && npm ci"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/frontend/**/*.{js,jsx}",
      "!src/frontend/**/__tests__/**",
      "!src/frontend/index.jsx"
    ],
    "coverageReporters": [
      "json-summary",
      "lcov",
      "text-summary"
    ],
    "testMatch": [
      "<rootDir>/src/frontend/**/__tests__/**/*.{js,jsx}",
      "<rootDir>/src/frontend/**/*.{spec,test}.{js,jsx}"
    ],
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!axios)"
    ],
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9"
  },
  "proxy": "http://localhost:5000",
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
