{
  "name": "peer-evaluation-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.0",
    "vite": "^8.3.3"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src/frontend src/index.jsx src/setupTests.js --max-warnings=0",
    "start:backend": "cd src/backend && npm start",
    "start:frontend": "vite",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "setup": "node scripts/setup.js",
    "verify": "bash scripts/verify-env.sh",
    "docker:up": "node scripts/setup.js --env-only && docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "postinstall": "cd src/backend && npm ci"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
